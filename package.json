{
  "name": "jira-convention-checker",
  "version": "1.0.0",
  "engines": {
    "node": ">= 20"
  },
  "private": true,
  "description": "Check if follows the convention for automation in JIRA.",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "lint": "eslint src/**/*.ts",
    "pack": "dotenv -e .env ncc build",
    "test": "jest",
    "test:watch": "jest --watch",
    "all": "npm run build && npm run format && npm run lint && npm run pack && npm test"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "author": "Antony Fagundez - Arquitectura",
  "dependencies": {
    "@actions/core": "^1.10.0",
    "@actions/exec": "^1.1.1",
    "@actions/github": "6.0.0",
    "@octokit/core": "^7.0.4",
    "@octokit/plugin-paginate-rest": "^13.1.1",
    "@octokit/plugin-rest-endpoint-methods": "^16.1.0",
    "dotenv": "^17.2.2",
    "jira.js": "^5.2.2",
    "picomatch": "^2.3.1"
  },
  "devDependencies": {
    "@octokit/webhooks-types": "^7.3.1",
    "@types/jest": "^29.5.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.6",
    "@types/picomatch": "^2.3.3",
    "@types/request": "^2.48.13",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "@vercel/ncc": "^0.38.1",
    "cross-env": "^10.0.0",
    "dotenv-cli": "^10.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-github": "^4.10.1",
    "eslint-plugin-jest": "^27.6.3",
    "jest": "^29.7.0",
    "jest-circus": "^29.7.0",
    "js-yaml": "^4.1.0",
    "node-fetch": "^3.3.2",
    "prettier": "^2.8.8",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1"
  }
}
